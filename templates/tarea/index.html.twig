{% extends 'base.html.twig' %}

{% block title %}Tareas de {{ miembro }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/estilos.css') }}">
{% endblock %}

{% block body %}
    <main class="contenedor-principal">
        <h1 class="miembro">Tarea para {{ miembro }}</h1>
        <ul class="contenedor-tarea">
            {% for tarea in tareas %}
                <li class="tarea">{{ tarea }}</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}